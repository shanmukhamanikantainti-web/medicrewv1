# MediCrew Bridge Server — Environment Variables
# Copy this to .env and fill in your values

# ── Supabase (REQUIRED) ──────────────────────────────────────────────────────
SUPABASE_URL=https://raroozindajlweijpxnw.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Device (REQUIRED: only the ID) ───────────────────────────────────────────
DEVICE_ID=HEALTH01

# ── OPTIONAL: Manual device URL (skip auto-scan if you know the IP) ──────────
# Leave empty to auto-discover on the network
# DEVICE_STREAM_URL=http://192.168.1.42/data

# ── OPTIONAL: Polling interval (ms) ──────────────────────────────────────────
POLL_INTERVAL_MS=3000

# ── OPTIONAL: Ports to scan during auto-discovery ────────────────────────────
SCAN_PORTS=80,8080,3000,5000
