# MediCrew Bridge Server — Environment Variables
# Copy this file to .env and fill in your values

# ── Supabase ──────────────────────────────────────────────────────────────────
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://raroozindajlweijpxnw.supabase.co

# Use the SERVICE ROLE key (not anon key) so the bridge can write without auth
# Get from: Supabase Dashboard → Settings → API → service_role (secret)
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ── Device Configuration ──────────────────────────────────────────────────────
# The full URL where your device serves JSON data
# Examples:
#   http://192.168.1.42/data
#   http://10.54.100.170/vitals
#   http://esp32-device.local/json
DEVICE_STREAM_URL=http://10.249.96.170/

# The device ID as it appears in the MediCrew app (must match what user linked)
DEVICE_ID=HEALTH01

# How often to poll (milliseconds). Default: 3000 (3 seconds)
POLL_INTERVAL_MS=3000
